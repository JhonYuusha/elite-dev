generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CLIENT
  GATEKEEPER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum SeatType {
  STANDARD
  VIP
  ACCESSIBLE
  COMPANION
}

enum ProductCategory {
  POPCORN
  DRINK
  COMBO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  organizedEvents  Event[]
  reservations     Reservation[]
  ownedTickets     Ticket[]      @relation("TicketOwner")
  validatedTickets Ticket[]      @relation("TicketValidator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(uuid())

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  externalProvider String
  externalId       String

  title       String
  description String?
  imageUrl    String?

  startsAt DateTime

  venueName    String
  venueAddress String?

  capacity         Int
  availableTickets Int

  priceCents Int

  status EventStatus @default(DRAFT)

  reservations Reservation[]
  tickets      Ticket[]
  seats        Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([externalProvider, externalId])
}

model Reservation {
  id String @id @default(uuid())

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  quantity Int

  ticketUnitPriceCents Int @default(0)
  ticketsSubtotalCents Int @default(0)
  productsSubtotalCents Int @default(0)
  totalCents            Int

  status ReservationStatus @default(PENDING)

  tickets Ticket[]
  seats   Seat[]
  items   ReservationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([eventId])
}

model Ticket {
  id String @id @default(uuid())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  ownerId String
  owner   User   @relation("TicketOwner", fields: [ownerId], references: [id])

  seatId String? @unique
  seat   Seat?   @relation(fields: [seatId], references: [id])

  status TicketStatus @default(VALID)

  shareToken String? @unique

  validatedAt DateTime?

  validatedById String?
  validatedBy   User?   @relation("TicketValidator", fields: [validatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([ownerId])
}

model Seat {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  row    String
  number Int
  label  String

  type   SeatType   @default(STANDARD)
  status SeatStatus @default(AVAILABLE)

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, label])
  @@index([eventId, status])
  @@index([reservationId])
}

model Product {
  id String @id @default(uuid())

  slug String @unique
  name String

  description String?
  imageUrl    String?

  category ProductCategory

  priceCents Int

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  reservationItems ReservationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
  @@index([sortOrder])
}

model ReservationItem {
  id String @id @default(uuid())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPriceCents Int
  totalCents     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, productId])
  @@index([reservationId])
  @@index([productId])
}